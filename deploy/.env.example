# Copy to .env on the client's server (chmod 600). Never send this file by email or chat.

# Image loaded with `docker load` (name:tag printed by build-release.ps1).
DORA_IMAGE=dora:CLIENTID-BUILDID

# Public or intranet host name served by Caddy.
DORA_DOMAIN=hr.client.co.id

# REQUIRED: 32-byte data encryption key. Generate ON THE CLIENT SERVER:
#   docker run --rm node:24-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store an offline copy (sealed envelope / client's password manager). Lose it = lose the data.
DORA_DATA_KEY=

# REQUIRED for backups: at least 16 characters, stored apart from the backups.
DORA_BACKUP_PASSPHRASE=

# Optional SMTP for outgoing email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
