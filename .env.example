# Copy to .env and fill in. Never commit .env.

# SQLite database file (relative to prisma/ for local runs; /data/dora.db inside Docker).
DATABASE_URL="file:./dora.db"

# REQUIRED. 32-byte key that encrypts NIK, NPWP, bank accounts, BPJS numbers, history snapshots
# and uploaded files (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep an offline copy: without it the encrypted data and backups cannot be read.
DORA_DATA_KEY=""

# Optional, only during key rotation: old keys still accepted for reading (comma-separated).
# DORA_DATA_KEYS_PREVIOUS=""

# REQUIRED for backups. At least 16 characters. Store apart from the backups.
# DORA_BACKUP_PASSPHRASE=""

# Number of reverse proxies in front of DORA that append to X-Forwarded-For (Caddy/Nginx = 1).
# DORA_TRUSTED_PROXY_HOPS=1

# Secure session cookies default to on in production. Only set false on a closed intranet without TLS.
# DORA_COOKIE_SECURE=true

# SMTP for outgoing email (optional; without it emails are only logged).
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
