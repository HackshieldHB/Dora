# HTTPS in front of DORA. Set DORA_DOMAIN in .env (e.g. hr.client.co.id).
# Public domain: Caddy obtains and renews a Let's Encrypt certificate automatically (ports 80/443 open).
# Intranet-only name: uncomment `tls internal` and install Caddy's root certificate on client devices,
# or replace it with `tls /path/cert.pem /path/key.pem` from the client's own CA.
{$DORA_DOMAIN} {
	# tls internal
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy dora:3000
	log {
		output stdout
		format json
	}
}
