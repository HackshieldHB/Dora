generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlatformSetting {
  id                Int @id @default(1)
  passwordMinLength Int @default(8)
  requireUpper      Boolean @default(true)
  requireLower      Boolean @default(true)
  requireDigit      Boolean @default(true)
  sessionTimeoutMin Int @default(480)
  maxFailedLogins   Int @default(5)
  lockoutMin        Int @default(15)
  tempPasswordHours Int @default(24)
  regulatoryCheckedAt DateTime?
  regulatoryCheckResult String @default("")
  // Latest time the license check has seen. A clock set far behind this means someone
  // rolled the system clock back to stretch an expired license.
  licenseSeenAt     DateTime?
}

model Company {
  id                String   @id @default(cuid())
  name              String
  legalName         String   @default("")
  npwp              String   @default("")
  address           String   @default("")
  phone             String   @default("")
  email             String   @default("")
  prorateSalary     Boolean  @default(false)
  passwordMinLength Int      @default(8)
  requireUpper      Boolean  @default(true)
  requireLower      Boolean  @default(true)
  requireDigit      Boolean  @default(true)
  sessionTimeoutMin Int      @default(480)
  maxFailedLogins   Int      @default(5)
  lockoutMin        Int      @default(15)
  tempPasswordHours Int      @default(24)
  createdAt         DateTime @default(now())
  users             User[]
  roles             Role[]
  branches          Branch[]
  locations         WorkLocation[]
  departments       Department[]
  positions         Position[]
  employees         Employee[]
  holidays          Holiday[]
  leaveTypes        LeaveType[]
  shifts            Shift[]
  attendancePolicy  AttendancePolicy?
  overtimePolicy    OvertimePolicy?
  components        PayrollComponent[]
  periods           PayrollPeriod[]
  extras            ExtraPay[]
  statutory         CompanyStatutorySetting?
  auditLogs         AuditLog[]
  tasks             ApprovalTask[]
  delegations       Delegation[]
  orgChanges        OrgChange[]
  reimbursements    Reimbursement[]
  announcements     Announcement[]
  shiftSwaps        ShiftSwap[]
  warnings          WarningLetter[]
  meetings          OneOnOne[]
  timesheets        Timesheet[]
}

model User {
  id                 String    @id @default(cuid())
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id])
  email              String    @unique
  passwordHash       String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  status             String    @default("ACTIVE")
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  tempPasswordUntil  DateTime?
  payslipPinHash     String    @default("")
  dataScope          String    @default("")
  locale             String    @default("en")
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  sessions           Session[]
  notifications      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  key         String
  name        String
  isDefault   Boolean  @default(false)
  isCustom    Boolean  @default(false)
  dataScope   String   @default("SELF")
  scopeRefId  String   @default("")
  layout      String   @default("standard")
  permissions String   @default("[]")
  active      Boolean  @default(true)
  users       User[]
  @@unique([companyId, key])
}

model Branch {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  code      String
  address   String     @default("")
  employees Employee[]
  locations WorkLocation[]
  @@unique([companyId, code])
}

model WorkLocation {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name         String
  address      String  @default("")
  lat          Float?
  lng          Float?
  radiusMeters Int     @default(0)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  employees    Employee[]
}

model Department {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name        String
  maxOnLeave  Int          @default(0)
  parentId    String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]
}

model Position {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  employees Employee[]
}

model Employee {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  employeeCode     String
  status           String   @default("DRAFT")
  fullName         String
  email            String   @default("")
  phone            String   @default("")
  address          String   @default("")
  emergencyName    String   @default("")
  emergencyPhone   String   @default("")
  nik              String   @default("")
  npwp             String   @default("")
  ptkp             String   @default("TK/0")
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  locationId       String?
  location         WorkLocation? @relation(fields: [locationId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  positionId       String?
  position         Position? @relation(fields: [positionId], references: [id])
  managerId        String?
  manager          Employee? @relation("Reports", fields: [managerId], references: [id])
  accessRoleId     String   @default("")
  reports          Employee[] @relation("Reports")
  joinDate         String   @default("")
  birthDate        String   @default("")
  employmentType   String   @default("PERMANENT")
  contractEnd      String   @default("")
  contractDecision String   @default("")
  basicSalary      Int      @default(0)
  bankName         String   @default("")
  bankAccount      String   @default("")
  bpjsHealthNo     String   @default("")
  bpjsHealthOn     Boolean  @default(false)
  bpjsHealthClass  String   @default("")
  bpjsHealthStart  String   @default("")
  bpjsTkNo         String   @default("")
  bpjsTkOn         Boolean  @default(false)
  bpjsJht          Boolean  @default(false)
  bpjsJkk          Boolean  @default(false)
  bpjsJkm          Boolean  @default(false)
  bpjsJp           Boolean  @default(false)
  bpjsTkStart      String   @default("")
  taxStatus        String   @default("")
  ptkpStart        String   @default("")
  insuranceName    String   @default("")
  insuranceNo      String   @default("")
  exitType         String   @default("")
  exitReason       String   @default("")
  lastWorkingDay   String   @default("")
  clearanceDone    Boolean  @default(false)
  clearanceAccess  Boolean  @default(false)
  clearanceAssets  Boolean  @default(false)
  clearanceBpjs    Boolean  @default(false)
  finalPayrollDone Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User?
  events           EmploymentEvent[]
  documents        EmployeeDocument[]
  profileChanges   ProfileChange[]
  schedules        EmployeeSchedule[]
  attendance       AttendanceRecord[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  payrollItems     PayrollItem[]
  extras           ExtraPay[]
  files            StoredFile[]
  attendanceRequests AttendanceRequest[]
  loans            EmployeeLoan[]
  goals            Goal[]
  reimbursements   Reimbursement[]
  swapRequests     ShiftSwap[] @relation("SwapRequester")
  swapAnswers      ShiftSwap[] @relation("SwapCounterpart")
  warnings         WarningLetter[]
  meetings         OneOnOne[]
  timesheets       Timesheet[]
  trainings        TrainingParticipant[]
  @@unique([companyId, employeeCode])
  @@index([companyId, status])
}

model EmploymentEvent {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  changeType    String
  effectiveDate String
  beforeJson    String
  afterJson     String
  applied       Boolean  @default(true)
  actorId       String
  createdAt     DateTime @default(now())
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String
  fileId     String
  expiresOn        String   @default("")
  trainingName     String   @default("")
  trainingProvider String   @default("")
  trainingDate     String   @default("")
  createdAt        DateTime @default(now())
}

model ProfileChange {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  field      String
  oldValue   String
  newValue   String
  sensitive  Boolean
  status     String   @default("PENDING")
  reviewerId String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())
}

model OrgChange {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  entityType    String
  entityId      String
  effectiveDate String
  beforeJson    String
  afterJson     String
  applied       Boolean  @default(false)
  actorId       String
  createdAt     DateTime @default(now())
}

model Shift {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  startTime        String
  endTime          String
  crossesMidnight  Boolean  @default(false)
  description      String   @default("")
  schedules        EmployeeSchedule[]
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  dayOfWeek      Int
  shiftId        String?
  shift          Shift?   @relation(fields: [shiftId], references: [id])
  effectiveStart String   @default("2026-01-01")
  effectiveEnd   String   @default("")
  @@index([employeeId, dayOfWeek])
}

model Holiday {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  date      String
  name      String
  @@unique([companyId, date])
}

model AttendancePolicy {
  id                     String  @id @default(cuid())
  companyId              String  @unique
  company                Company @relation(fields: [companyId], references: [id])
  graceMinutes           Int     @default(0)
  lateDeductionPerMinute Int     @default(0)
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  workDate     String
  shiftName    String   @default("")
  shiftStart   String   @default("")
  shiftEnd     String   @default("")
  clockInAt    String   @default("")
  clockOutAt   String   @default("")
  inLat        Float?
  inLng        Float?
  inPhotoId    String   @default("")
  outLat       Float?
  outLng       Float?
  outPhotoId   String   @default("")
  status       String   @default("PRESENT")
  lateMinutes  Int      @default(0)
  source       String   @default("CLOCK")
  requestId    String   @default("")
  corrections  AttendanceCorrection[]
  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
}

model AttendanceRequest {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  workDate     String
  kind         String
  place        String
  note         String   @default("")
  clockInAt    String   @default("")
  clockOutAt   String   @default("")
  endDate      String   @default("")
  status       String   @default("PENDING")
  approverId   String   @default("")
  decisionNote String   @default("")
  createdAt    DateTime @default(now())
  @@index([companyId, status])
  @@index([employeeId, workDate])
}

model AttendanceCorrection {
  id         String           @id @default(cuid())
  recordId   String
  record     AttendanceRecord @relation(fields: [recordId], references: [id])
  beforeJson String
  afterJson  String
  reason     String
  actorId    String
  createdAt  DateTime         @default(now())
}

model LeaveType {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  name               String
  balanceMode        String   @default("NONE")
  quotaDays          Float    @default(0)
  requiresAttachment Boolean  @default(false)
  paid               Boolean  @default(true)
  allowHalfDay       Boolean  @default(false)
  carryForwardDays   Float    @default(0)
  expiryMonth        Int      @default(0)
  quotaPeriod        String   @default("YEARLY")
  accrualRate        Float    @default(0)
  expiryDate         String   @default("")
  legalNote          String   @default("")
  maxCalendarDays    Int      @default(0)
  minServiceMonths   Int      @default(0)
  requiresReason     Boolean  @default(false)
  balances           LeaveBalance[]
  requests           LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  entitled    Float
  used        Float     @default(0)
  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    String
  endDate      String
  halfDay      Boolean   @default(false)
  halfStart    String    @default("")
  halfEnd      String    @default("")
  days         Float
  reason       String    @default("")
  attachmentId String    @default("")
  coverId      String    @default("")
  status       String    @default("PENDING")
  approverId   String    @default("")
  decisionNote String    @default("")
  createdAt    DateTime  @default(now())
  @@index([companyId, status])
}

model OvertimePolicy {
  id              String  @id @default(cuid())
  companyId       String  @unique
  company         Company @relation(fields: [companyId], references: [id])
  allowBefore     Boolean @default(false)
  allowAfter      Boolean @default(true)
  multiplier      Float   @default(1.5)
  hourlyDivisor   Float   @default(173)
  maxHoursPerDay  Float   @default(0)
  roundingMinutes Int     @default(1)
  mealAllowance   Int     @default(0)
}

model OvertimeRequest {
  id                 String   @id @default(cuid())
  companyId          String
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id])
  workDate           String
  startTime          String
  endTime            String
  reason             String   @default("")
  status             String   @default("PENDING")
  approverId         String   @default("")
  decisionNote       String   @default("")
  validMinutes       Int      @default(0)
  compensationIdr    Int      @default(0)
  compensationStatus String   @default("NOT_READY")
  reviewNote         String   @default("")
  reviewedBy         String   @default("")
  payrollPeriodId    String   @default("")
  mealPosted         Boolean  @default(false)
  createdAt          DateTime @default(now())
  @@index([companyId, status])
}

model PayrollComponent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  kind      String
  calc      String  @default("FIXED")
  amount    Int     @default(0)
  active    Boolean @default(true)
}

model PayrollPeriod {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  kind             String   @default("REGULAR")
  startDate        String
  endDate          String
  cutoffDate       String
  payDate          String
  status           String   @default("DRAFT")
  payslipPublished Boolean  @default(false)
  preparedById     String   @default("")
  approvedById     String   @default("")
  decisionNote     String   @default("")
  warningNote      String   @default("")
  sourcePeriodId   String   @default("")
  needsRecalc      Boolean  @default(false)
  statutoryRuleId  String   @default("")
  createdAt        DateTime @default(now())
  items            PayrollItem[]
  adjustments      PayrollAdjustment[]
}

model PayrollItem {
  id           String        @id @default(cuid())
  periodId     String
  period       PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  breakdown    String
  gross        Int           @default(0)
  deduction    Int           @default(0)
  net          Int           @default(0)
  pph21        Int           @default(0)
  bpjsEmployee Int           @default(0)
  bpjsEmployer Int           @default(0)
  @@unique([periodId, employeeId])
}

model PayrollAdjustment {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  name       String
  kind       String
  amount     Int
  reason          String
  actorId         String
  beforeGross     Int           @default(0)
  beforeDeduction Int           @default(0)
  beforeNet       Int           @default(0)
  beforePph21     Int           @default(0)
  beforeAmount    Int           @default(0)
  afterNet        Int?
  createdAt  DateTime      @default(now())
}

model EmployeeLoan {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  amount       Int
  tenor        Int
  installment  Int
  remaining    Int
  reason       String   @default("")
  status       String   @default("PENDING")
  approverId   String   @default("")
  decisionNote String   @default("")
  createdAt    DateTime @default(now())
  installments LoanInstallment[]
  @@index([companyId, status])
}

model Announcement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String
  body      String
  endsOn    String
  authorId  String
  createdAt DateTime @default(now())
}

model ShiftSwap {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  requesterId        String
  requester          Employee @relation("SwapRequester", fields: [requesterId], references: [id])
  counterpartId      String
  counterpart        Employee @relation("SwapCounterpart", fields: [counterpartId], references: [id])
  workDate           String
  requesterShiftId   String
  counterpartShiftId String
  note               String   @default("")
  status             String   @default("PENDING")
  approverId         String   @default("")
  decisionNote       String   @default("")
  createdAt          DateTime @default(now())
  @@index([companyId, status])
}

model WarningLetter {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  level      String
  month      String
  lateDays   Int
  note       String
  actorId    String
  createdAt  DateTime @default(now())
  @@index([companyId, employeeId])
}

model OneOnOne {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  meetingDate String
  note       String
  authorId   String
  createdAt  DateTime @default(now())
  @@index([employeeId, meetingDate])
}

model Timesheet {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  workDate     String
  client       String
  hours        Float
  note         String   @default("")
  status       String   @default("PENDING")
  approverId   String   @default("")
  decisionNote String   @default("")
  createdAt    DateTime @default(now())
  @@index([companyId, status])
}

model Reimbursement {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  kind         String
  amount       Int
  expenseDate  String
  note         String   @default("")
  fileId       String
  status       String   @default("PENDING")
  approverId   String   @default("")
  decisionNote String   @default("")
  periodId     String   @default("")
  createdAt    DateTime @default(now())
  @@index([companyId, status])
}

model LoanInstallment {
  id        String       @id @default(cuid())
  loanId    String
  loan      EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  periodId  String
  amount    Int
  createdAt DateTime     @default(now())
  @@unique([loanId, periodId])
}

model Goal {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  departmentId String   @default("")
  assignedById String   @default("")
  title        String
  metric       String
  unit         String   @default("")
  target       Float
  current      Float    @default(0)
  startDate    String
  endDate      String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  @@index([companyId, employeeId])
}

model ExtraPay {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  kind       String
  mode       String   @default("MANUAL")
  amount     Int      @default(0)
  @@unique([employeeId, year, kind])
}

model StatutoryRule {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  effectiveFrom String
  active        Boolean @default(false)
  status           String   @default("VALIDATED")
  approvalStatus   String   @default("SAMPLE")
  source           String   @default("")
  reference        String   @default("")
  kind             String   @default("PPh 21 and BPJS")
  rejectionReason  String   @default("")
  reviewedBy       String   @default("")
  definition       String
  note             String   @default("")
  createdAt        DateTime @default(now())
}

model CompanyStatutorySetting {
  id              String  @id @default(cuid())
  companyId       String  @unique
  company         Company @relation(fields: [companyId], references: [id])
  ruleId          String
  jkkClass        Int     @default(1)
  bpjsKesEnabled  Boolean @default(true)
  includeOvertime Boolean @default(false)
}

model ApprovalTask {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  module             String
  subjectId          String
  assigneeId         String
  originalAssigneeId String   @default("")
  requesterId        String
  title              String
  href               String   @default("")
  status             String   @default("PENDING")
  lastRemindedAt     DateTime?
  createdAt          DateTime @default(now())
  decisions          ApprovalDecision[]
  @@index([assigneeId, status])
  @@index([companyId, module])
}

model ApprovalDecision {
  id        String       @id @default(cuid())
  taskId    String
  task      ApprovalTask @relation(fields: [taskId], references: [id])
  actorId   String
  decision  String
  note      String       @default("")
  createdAt DateTime     @default(now())
}

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  module      String
  active      Boolean  @default(true)
  allowReturn Boolean  @default(false)
  levelsJson  String
  createdAt   DateTime @default(now())
  @@index([companyId, module, active])
}

model ApprovalRoute {
  id           String  @id @default(cuid())
  companyId    String
  subjectId    String
  workflowKey  String
  taskModule   String
  requesterId  String
  employeeId   String  @default("")
  title        String
  href         String  @default("")
  levelsJson   String
  currentLevel Int     @default(1)
  allowReturn  Boolean @default(false)
  @@unique([companyId, subjectId])
}

model Delegation {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  fromUserId String
  toUserId   String
  modules    String
  startDate  String
  endDate    String
  active     Boolean  @default(true)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Training {
  id           String                @id @default(cuid())
  companyId    String
  name         String
  category     String
  description  String                @default("")
  objective    String                @default("")
  sessionDate  String
  startTime    String
  endTime      String
  method       String
  place        String                @default("")
  trainer      String                @default("")
  capacity     Int                   @default(1)
  target       String                @default("")
  materialUrl  String                @default("")
  enrollment   String                @default("OPEN")
  status       String                @default("SCHEDULED")
  createdAt    DateTime              @default(now())
  participants TrainingParticipant[]
  @@index([companyId, sessionDate])
}

model TrainingParticipant {
  id            String              @id @default(cuid())
  trainingId    String
  training      Training            @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  status        String              @default("ASSIGNED")
  attendance    String              @default("")
  certificateId String              @default("")
  createdAt     DateTime            @default(now())
  evaluation    TrainingEvaluation?
  @@unique([trainingId, employeeId])
  @@index([employeeId])
}

model TrainingEvaluation {
  id            String              @id @default(cuid())
  participantId String              @unique
  participant   TrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  overall       Int
  material      Int
  delivery      Int
  facility      Int
  relevance     Int
  comment       String              @default("")
  createdAt     DateTime            @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  companyId String?
  to        String
  subject   String
  body      String
  status    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  actorId   String
  action    String
  entity    String
  entityId  String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}

model StoredFile {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  path       String
  name       String
  createdAt  DateTime @default(now())
}

model PayslipGrant {
  id        String   @id @default(cuid())
  userId    String
  periodId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
